# Configuration de l'API
API_PORT=8000
API_HOST=0.0.0.0

# User-Agent obligatoire pour Wikipédia
WIKIPEDIA_USER_AGENT=WikiCards-IAMSI (contact@example.com)

# Rate limiting (requêtes/seconde)
WIKIPEDIA_RATE_LIMIT=2

# Dolibarr (à configurer plus tard)
# DOLIBARR_API_KEY=your_key_here
# DOLIBARR_BASE_URL=http://localhost:8080/api/index.php