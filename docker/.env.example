# Copier en docker/.env (jamais commité)

# Token du tunnel Cloudflare (Zero Trust > Networks > Tunnels > wikiblox > token)
CLOUDFLARE_TUNNEL_TOKEN=

# Mots de passe base de données / Dolibarr
# ATTENTION : MariaDB ne prend ces valeurs qu'à la PREMIÈRE création du volume.
DB_ROOT_PASSWORD=dolibarr
DB_PASSWORD=dolibarr
DOLI_ADMIN_PASSWORD=admin
